# ==========================================
# ARSelNel Environment Configuration (.env)
# ==========================================

# Supabase (Browser-safe Public Credentials)
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME

# SelBot AI Assistant Server-side Credentials (Do NOT commit to git)
# Dapatkan Gemini API Key percuma di Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE

# Pilihan Tambahan Pembekal LLM (Pilihan alternatif)
# OPENAI_API_KEY=sk-proj-YOUR_OPENAI_API_KEY
# GROQ_API_KEY=gsk_YOUR_GROQ_API_KEY
