# Copy this file to .env and fill in the Supabase project's browser-safe values.
# A publishable key (or legacy anon key) is safe to expose in browser code when
# Row Level Security is enabled. Never put a service_role/secret key here.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME

